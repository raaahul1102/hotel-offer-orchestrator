{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregates hotel offers from two mock suppliers, dedupes by name, selects the best price per hotel, orchestrated with Temporal and cached/filtered in Redis.",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "ts-node src/api/server.ts",
    "dev:worker": "ts-node src/temporal/worker.ts",
    "test": "jest --run --config jest.config.js"
  },
  "keywords": [
    "temporal",
    "redis",
    "express",
    "hotels"
  ],
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.9.3",
    "@temporalio/client": "^1.9.3",
    "@temporalio/worker": "^1.9.3",
    "@temporalio/workflow": "^1.9.3",
    "axios": "^1.7.2",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
